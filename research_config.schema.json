{
  "$defs": {
    "Crawl": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "per_category": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Per Category",
          "type": "integer"
        },
        "shortlist": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Shortlist",
          "type": "integer"
        }
      },
      "required": [
        "categories",
        "per_category",
        "shortlist"
      ],
      "title": "Crawl",
      "type": "object"
    },
    "DatasetSelection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "daily_limit": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Daily Limit",
          "type": "integer"
        },
        "review_limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Review Limit",
          "type": "integer"
        },
        "queries_per_day": {
          "default": 12,
          "maximum": 30,
          "minimum": 1,
          "title": "Queries Per Day",
          "type": "integer"
        },
        "results_per_query": {
          "default": 20,
          "maximum": 50,
          "minimum": 2,
          "title": "Results Per Query",
          "type": "integer"
        },
        "card_chars": {
          "default": 12000,
          "maximum": 24000,
          "minimum": 2000,
          "title": "Card Chars",
          "type": "integer"
        },
        "candidate_limit": {
          "default": 2000,
          "maximum": 5000,
          "minimum": 100,
          "title": "Candidate Limit",
          "type": "integer"
        },
        "recheck_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 7,
          "title": "Recheck Days",
          "type": "integer"
        },
        "queries": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Queries",
          "type": "object"
        },
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "object"
        }
      },
      "title": "DatasetSelection",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "brief_sentences": {
          "maximum": 6,
          "minimum": 2,
          "title": "Brief Sentences",
          "type": "integer"
        },
        "detail_words": {
          "maximum": 3000,
          "minimum": 200,
          "title": "Detail Words",
          "type": "integer"
        },
        "sections": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "language",
        "brief_sentences",
        "detail_words",
        "sections"
      ],
      "title": "Output",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "properties": {
        "max_fulltext_papers": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Fulltext Papers"
        },
        "chunk_chars": {
          "default": 24000,
          "maximum": 48000,
          "minimum": 4000,
          "title": "Chunk Chars",
          "type": "integer"
        },
        "max_revisions": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Revisions",
          "type": "integer"
        }
      },
      "title": "Reading",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "research_goal": {
      "minLength": 1,
      "title": "Research Goal",
      "type": "string"
    },
    "directions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Directions",
      "type": "object"
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "grades": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Grades",
      "type": "object"
    },
    "exclusions": {
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "examples": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Examples",
      "type": "array"
    },
    "retain_grades": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Retain Grades",
      "type": "array"
    },
    "crawl": {
      "$ref": "#/$defs/Crawl"
    },
    "keyword_profile": {
      "title": "Keyword Profile",
      "type": "object"
    },
    "reading": {
      "$ref": "#/$defs/Reading"
    },
    "output": {
      "$ref": "#/$defs/Output"
    },
    "datasets": {
      "$ref": "#/$defs/DatasetSelection"
    }
  },
  "required": [
    "version",
    "name",
    "research_goal",
    "directions",
    "questions",
    "grades",
    "exclusions",
    "examples",
    "retain_grades",
    "crawl",
    "keyword_profile",
    "models",
    "reading",
    "output"
  ],
  "title": "ResearchConfig",
  "type": "object"
}
